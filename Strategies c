"""Bot C – Long/Short-Strategien auf Small/Mid-Caps mit Hebel. Tageskerzen.
Rueckgabe: "long", "short" oder None. Exits ueber exit_signal()."""

def _chg(p, n): return p[-1] / p[-1 - n] - 1 if len(p) > n else 0
def _avg(x):    return sum(x) / len(x) if x else 0

def c1_breakout(prices, vols):
    """Ausbruch: Schluss ueber 20-Tage-Hoch -> long, unter 20-Tage-Tief -> short."""
    if len(prices) < 22: return None
    w = prices[-21:-1]
    if prices[-1] > max(w): return "long"
    if prices[-1] < min(w): return "short"
    return None

def c2_pump_fade(prices, vols):
    """Uebertreibung shorten: +40 % in 3 Tagen -> short. Panik kaufen: -25 % in 3 Tagen -> long."""
    if len(prices) < 5: return None
    c = _chg(prices, 3)
    if c > 0.40: return "short"
    if c < -0.25: return "long"
    return None

def c3_trend_vol(prices, vols):
    """Trend mit Volumenbestaetigung: 7d-Return > +15 % / < -15 % und 7d-Volumen > 1,3x 30d-Schnitt."""
    if len(prices) < 31: return None
    conf = _avg(vols[-7:]) / max(_avg(vols[-30:]), 1) > 1.3
    c = _chg(prices, 7)
    if conf and c > 0.15: return "long"
    if conf and c < -0.15: return "short"
    return None

def c4_short_only_fade(prices, vols):
    """Nur short: +60 % in 3 Tagen, danach erster roter Tag."""
    if len(prices) < 5: return None
    return "short" if _chg(prices, 3) > 0.60 and prices[-1] < prices[-2] else None

STRATEGIES = {"C1_breakout": c1_breakout, "C2_pump_fade": c2_pump_fade,
              "C3_trend_vol": c3_trend_vol, "C4_short_fade": c4_short_only_fade}

# (take_profit, stop, max_hold_days, trailing) – in % der Preisbewegung (ohne Hebel).
# Stop muss enger sein als die Liquidation: bei 3x liegt die bei ~ -31,7 % Preisbewegung.
EXITS = {"C1_breakout":  (None, -0.10, 30, -0.12),
         "C2_pump_fade": (0.12, -0.08, 7, None),
         "C3_trend_vol": (None, -0.10, 20, -0.15),
         "C4_short_fade": (0.20, -0.12, 5, None)}

def exit_signal(strategy, side, entry, price, peak, held_days):
    tp, stop, max_d, trail = EXITS[strategy]
    x = (price / entry - 1) * (1 if side == "long" else -1)
    if stop is not None and x <= stop: return "stop"
    if tp is not None and x >= tp: return "tp"
    if trail is not None and peak:
        off = (price / peak - 1) * (1 if side == "long" else -1)
        if off <= trail and x > 0: return "trail"
    if held_days >= max_d: return "time"
    return None
